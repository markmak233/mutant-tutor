# Copy to .env and fill in. .env is git-ignored; never commit real paths or keys.

# Course workspace, outside this repo (must contain workspace.toml)
WORKSPACE_DIR=/path/to/smartcodereview-workspace/bigdata
# Optional; defaults to $WORKSPACE_DIR/lectures
# LECTURE_DIR=

# JDK 17 (used by both Spark and Hadoop)
JAVA_HOME=/path/to/jdk-17

# Standalone Hadoop 3.3.x, for MRJob exercises that need partitioner / sort order
HADOOP_HOME=/path/to/hadoop-3.3.6
